if [ "${1:-}" = "--edit" ]; then
  for ed in kate kwrite xdg-open; do
    if command -v "$ed" >/dev/null 2>&1; then
      exec "$ed" "$SNIPPET_FILE"
    fi
  done
  echo "No editor found, edit manually: $SNIPPET_FILE"
  exit 1
