/**
 * Snippet picker — category header on top, cream grid (size set via -theme-str).
 * Cursor locked on center (current item); surrounding items move.
 * Esc / click-to-exit dismisses (see launcher mouse cancel binding).
 *
 * Note: fullscreen dim overlays break listview text on rofi 2.x Wayland, so the
 * window stays sized to the grid instead of covering the screen.
 */
* {
    cream:            #e8dcc8;
    cream-selected:   #f2e9d8;
    sage:             #b7c9b0;
    sage-selected:    #c5d5bf;
    ink:              #111111;
    void:             #000000;
    background-color: transparent;
    text-color:       @ink;
    spacing:          0;
}

configuration {
    show-icons:    false;
    click-to-exit: true;
}

window {
    background-color: @void;
    border:           0;
    padding:          40px;
    width:            40em;
}

mainbox {
    children:         [ message, listview ];
    spacing:          28px;
    padding:          8px;
    background-color: @void;
}

/* Hide unused search bar */
inputbar {
    enabled:          false;
}

/* Category header — message textbox centers reliably */
message {
    background-color: @sage;
    text-color:       @ink;
    padding:          14px 20px;
    expand:           false;
    width:            100%;
}

textbox {
    background-color: @sage;
    text-color:       @ink;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    expand:           true;
    width:            100%;
    padding:          0;
}

listview {
    columns:          3;
    lines:            3;
    fixed-columns:    true;
    fixed-height:     false;
    cycle:            true;
    flow:             horizontal;
    scrollbar:        false;
    spacing:          16px;
    background-color: @void;
}

element {
    padding:          24px 16px;
    background-color: @cream;
    text-color:       @ink;
    cursor:           pointer;
    orientation:      vertical;
    children:         [ element-text ];
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    highlight:        none;
    padding:          8px 6px;
}

element selected {
    background-color: @cream-selected;
    text-color:       @ink;
    border:           2px;
    border-color:     @cream;
}

element normal {
    background-color: @cream;
    text-color:       @ink;
}

/* Category tabs (script marks them urgent) */
element urgent {
    background-color: @sage;
    text-color:       @ink;
}

element normal.urgent {
    background-color: @sage;
    text-color:       @ink;
}

element alternate.urgent {
    background-color: @sage;
    text-color:       @ink;
}

element selected.urgent {
    background-color: @sage-selected;
    text-color:       @ink;
    border:           2px;
    border-color:     @sage;
}
